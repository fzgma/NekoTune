# Script mode: merge per-platform extension packages built from the same source into OUTPUT.
# Every package must have the same id and version; their library maps are combined.
if(NOT OUTPUT OR NOT PACKAGES)
    message(FATAL_ERROR "OUTPUT and PACKAGES are required")
endif()
string(RANDOM LENGTH 12 suffix)
set(work "${CMAKE_CURRENT_BINARY_DIR}/nekotune-merge-${suffix}")
set(merged "")
set(libraries "{}")
foreach(package IN LISTS PACKAGES)
    get_filename_component(package "${package}" ABSOLUTE)
    file(REMOVE_RECURSE "${work}/next")
    file(ARCHIVE_EXTRACT INPUT "${package}" DESTINATION "${work}/next")
    file(READ "${work}/next/extension.json" json)
    if(NOT merged)
        set(merged "${json}")
    else()
        foreach(key id version qt)
            string(JSON left GET "${merged}" ${key})
            string(JSON right GET "${json}" ${key})
            if(NOT left STREQUAL right)
                message(FATAL_ERROR "${package}: ${key} ${right} does not match ${left}")
            endif()
        endforeach()
    endif()
    string(JSON count LENGTH "${json}" library)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON platform MEMBER "${json}" library ${index})
        string(JSON path GET "${json}" library ${platform})
        string(JSON libraries SET "${libraries}" ${platform} "\"${path}\"")
    endforeach()
    file(REMOVE "${work}/next/extension.json")
    file(COPY "${work}/next/" DESTINATION "${work}/merged")
endforeach()
string(JSON merged SET "${merged}" library "${libraries}")
file(WRITE "${work}/merged/extension.json" "${merged}\n")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DOUTPUT=${OUTPUT}" -P "${CMAKE_CURRENT_LIST_DIR}/NekoTunePackage.cmake"
    WORKING_DIRECTORY "${work}/merged" RESULT_VARIABLE result)
file(REMOVE_RECURSE "${work}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot write ${OUTPUT}")
endif()
